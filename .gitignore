# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / opennext build output
.open-next/
.wrangler/

# D1 bulk data exports (large, regenerated by export-to-d1.mjs)
sql/d1-data*.sql
sql/test-*.sql
test.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# large data files
*.zip
data/*.xlsx
scripts/scrapers/feeds/
nhs_dmd_extract/
